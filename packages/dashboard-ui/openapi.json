              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KBGraphSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb/{slug}": {
      "get": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Get single Knowledge Base article",
        "operationId": "getArticle",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KBArticleSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Stream live repository changes via Server-Sent Events (SSE)",
        "operationId": "streamEvents",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DashboardMetricsSchema": {
        "properties": {
          "total_issues": {
            "type": "integer",
            "title": "Total Issues",
            "default": 0
          },
          "open_issues": {
            "type": "integer",
            "title": "Open Issues",
            "default": 0
          },
          "in_progress_issues": {
            "type": "integer",
            "title": "In Progress Issues",
            "default": 0
          },
          "blocked_issues": {
            "type": "integer",
            "title": "Blocked Issues",
            "default": 0
          },
          "done_issues": {
            "type": "integer",
            "title": "Done Issues",
            "default": 0
          },
          "completion_pct": {
            "type": "integer",
            "title": "Completion Pct",
            "default": 0
          },
          "bug_debt_ratio": {
            "type": "number",
            "title": "Bug Debt Ratio",
            "default": 0.0
          },
          "active_risks": {
            "type": "integer",
            "title": "Active Risks",
            "default": 0
          },
          "active_milestones": {
            "type": "integer",
            "title": "Active Milestones",
            "default": 0
          },
          "total_kb_articles": {
            "type": "integer",
            "title": "Total Kb Articles",
            "default": 0
          },
          "total_decisions": {
            "type": "integer",
            "title": "Total Decisions",
            "default": 0
          },
          "total_sessions": {
            "type": "integer",
            "title": "Total Sessions",
            "default": 0
          },
          "by_status": {
            "$ref": "#/components/schemas/StatusBreakdown"
          },
          "by_type": {
            "$ref": "#/components/schemas/TypeBreakdown"
          },
          "by_priority": {
            "$ref": "#/components/schemas/PriorityBreakdown"
          },
          "scan_timestamp": {
            "type": "string",
            "title": "Scan Timestamp",
            "default": ""
          },
          "protocol_version": {
            "type": "string",
            "title": "Protocol Version",
            "default": "3.9.4"
          }
        },
        "type": "object",
        "title": "DashboardMetricsSchema",
        "description": "Aggregated project metrics.",
        "additionalProperties": false
      },
      "DecisionSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Decision identifier, e.g. ADR-001"
          },
          "slug": {
            "description": "Decision slug",
            "type": "string",
            "nullable": true
          },
          "number": {
            "description": "Sequential ADR number",
            "type": "integer",
            "nullable": true
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Decision title"
          },
          "date": {
            "description": "Date recorded YYYY-MM-DD",
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ADR status (Accepted, Superseded, etc.)",
            "default": "Accepted"
          },
          "context": {
            "description": "Context and problem description",
            "type": "string",
            "nullable": true
          },
          "decision": {
            "description": "Decision made",
            "type": "string",
            "nullable": true
          },
          "consequences": {
            "description": "Consequences and trade-offs",
            "type": "string",
            "nullable": true
          },
          "superseded_by": {
            "description": "ADR identifier that supersedes this",
            "type": "string",
            "nullable": true
          },
          "file_path": {
            "description": "Relative path to ADR file",
            "type": "string",
            "nullable": true
          },
          "raw_markdown": {
            "description": "Full raw markdown of the entry",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "title": "DecisionSchema",
        "description": "Schema for an ADR entry in .along/DECISIONS.md.",
        "additionalProperties": false
      },
      "FullDashboardDataSchema": {
        "properties": {
          "repo_name": {
            "type": "string",
            "title": "Repo Name"
          },
          "metrics": {
            "$ref": "#/components/schemas/DashboardMetricsSchema"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/IssueSchema"
            },
            "type": "array",
            "title": "Issues"
          },
          "milestones": {
            "items": {
              "$ref": "#/components/schemas/MilestoneSchema"
            },
            "type": "array",
            "title": "Milestones"
          },
          "risks": {
            "items": {
              "$ref": "#/components/schemas/RiskSchema"
            },
            "type": "array",
            "title": "Risks"
          },
          "spikes": {
            "items": {
              "$ref": "#/components/schemas/SpikeSchema"
            },
            "type": "array",
            "title": "Spikes"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionSchema"
            },
            "type": "array",
            "title": "Sessions"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/DecisionSchema"
            },
            "type": "array",
            "title": "Decisions"
          },
          "kb_articles": {
            "items": {
              "$ref": "#/components/schemas/KBArticleSchema"
            },
            "type": "array",
            "title": "Kb Articles"
          },
          "graph": {
            "additionalProperties": true,
            "type": "object",
            "title": "Graph"
          },
          "context_text": {
            "type": "string",
            "title": "Context Text",
            "default": ""
          },
          "issues_board_text": {
            "type": "string",
            "title": "Issues Board Text",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "repo_name",
          "metrics"
        ],
        "title": "FullDashboardDataSchema",
        "description": "Complete dataset for dashboard SPA.",
        "additionalProperties": false
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError",
        "additionalProperties": false
      },
      "IssueSchema": {
        "properties": {
          "protocol": {
            "type": "string",
            "title": "Protocol",
            "description": "Protocol identifier",
            "default": "along"
          },
          "slug": {
            "type": "string",
            "title": "Slug",
            "description": "Unique kebab-case slug of the entity"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Canonical entity identifier, e.g. feat--login"
          },
          "title": {
            "description": "Human readable title",
            "type": "string",
            "nullable": true
          },
          "body": {
            "description": "Markdown body content",
            "type": "string",
            "nullable": true
          },
          "file_path": {
            "description": "Relative file path in repository",
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "enum": [
              "feat",
              "bug",
              "debt",
              "task",
              "docs"
            ],
            "title": "Type",
            "description": "Issue type",
            "default": "feat"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in-progress",
              "blocked",
              "done",
              "superseded",
              "cancelled",
              "duplicate"
            ],
            "title": "Status",
            "description": "Current lifecycle status",
            "default": "open"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "title": "Priority",
            "description": "Priority level",
            "default": "medium"
          },
          "created": {
            "description": "Creation date YYYY-MM-DD",
            "type": "string",
            "nullable": true
          },
          "updated": {
            "description": "Last update date YYYY-MM-DD",
            "type": "string",
            "nullable": true
          },
          "completed": {
            "description": "Completion date YYYY-MM-DD",
            "type": "string",
            "nullable": true
          },
          "agent": {
            "description": "Agent or author that worked on the issue",
            "type": "string",
            "nullable": true
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "description": "Array of topical tags"
          },
          "milestone": {
            "description": "Milestone slug this issue belongs to",
            "type": "string",
            "nullable": true
          },
          "blocked_by": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Blocked By",
            "description": "List of blocking entity keys"
          },
          "related": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Related",
            "description": "List of related entity keys"
          },
          "parent": {
            "description": "Parent epic/entity key",
            "type": "string",
            "nullable": true
          },
          "superseded_by": {
            "description": "Canonical entity key that supersedes this issue",
            "type": "string",
            "nullable": true
          },
          "duplicate_of": {
            "description": "Canonical entity key this issue duplicates",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "slug",
          "id"
        ],
        "title": "IssueSchema",
        "description": "Schema for .along/ISSUES/<type>--<slug>.md.",
        "additionalProperties": false
      },
      "KBArticleSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique article ID, e.g. kb--architecture or docs--setup"
          },
          "slug": {
            "type": "string",
            "title": "Slug",
            "description": "Article slug or filename"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Article title"
          },
          "type": {
            "type": "string",
            "enum": [
              "topic",
              "architecture",
              "domain-model",
              "setup-workflow",
              "index",
              "doc"
            ],
            "title": "Type",
            "description": "Article topic category",
            "default": "topic"
          },
          "created": {
            "description": "Creation date YYYY-MM-DD",
            "type": "string",
            "nullable": true
          },
          "updated": {
            "description": "Last update date YYYY-MM-DD",
            "type": "string",
            "nullable": true
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "description": "List of topic tags"
          },
          "file_path": {
            "type": "string",
            "title": "File Path",
            "description": "Relative path in repository"
          },
          "body": {
            "type": "string",
            "title": "Body",
            "description": "Markdown body",
            "default": ""
          },
          "headings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headings",
            "description": "Extracted Markdown headings"
          },
          "outgoing_links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Outgoing Links",
            "description": "Outgoing wiki or entity links"
          },
          "incoming_links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Incoming Links",
            "description": "Incoming links referencing this article"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "file_path"
        ],
