    "/api/entities/sessions": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "List all session logs",
        "operationId": "listSessions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSchema"
                  },
                  "type": "array",
                  "title": "Response Listsessions"
                }
              }
            }
          }
        }
      }
    },
    "/api/entities/decisions": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "List all ADR decisions",
        "operationId": "listDecisions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DecisionSchema"
                  },
                  "type": "array",
                  "title": "Response Listdecisions"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb": {
      "get": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "List all Knowledge Base articles",
        "operationId": "listArticles",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by category type",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by category type"
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by tag",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by tag"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KBArticleSchema"
                  },
                  "title": "Response Listarticles"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb/search": {
      "get": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Search Knowledge Base and entities",
        "operationId": "searchKb",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Search query string",
              "default": "",
              "title": "Q"
            },
            "description": "Search query string"
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by tag",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by tag"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by entity type (kb, issue, decision, session)",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by entity type (kb, issue, decision, session)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb/graph": {
      "get": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Get Knowledge Base cross-link graph",
        "operationId": "getKbGraph",
        "responses": {
          "200": {
            "description": "Successful Response",
