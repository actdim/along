    },
    "/api/entities/spikes": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "List all spikes",
        "operationId": "listSpikes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SpikeSchema"
                  },
                  "type": "array",
                  "title": "Response Listspikes"
                }
              }
            }
          }
        }
