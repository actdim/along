{
  "openapi": "3.0.3",
  "info": {
    "title": "Along Dashboard & Knowledge Base API",
    "description": "Type-safe OpenAPI REST & SSE service for Along Protocol entities, dependency DAGs, and Knowledge Base search.",
    "version": "3.9.4"
  },
  "paths": {
    "/api/metrics": {
      "get": {
        "tags": [
          "Metrics & Data"
        ],
        "summary": "Get dashboard metrics",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardMetricsSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/data": {
      "get": {
        "tags": [
          "Metrics & Data"
        ],
        "summary": "Get full combined dashboard dataset",
        "operationId": "getFullData",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FullDashboardDataSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/graph": {
      "get": {
        "tags": [
          "Metrics & Data"
        ],
        "summary": "Get entity DAG dependency graph for Cytoscape",
        "operationId": "getDagGraph",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/entities/issues": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "List all issues",
        "operationId": "listIssues",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by status (open, in-progress, blocked, done)",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by status (open, in-progress, blocked, done)"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by type (feat, bug, debt, task, docs)",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by type (feat, bug, debt, task, docs)"
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by priority (critical, high, medium, low)",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by priority (critical, high, medium, low)"
          },
          {
            "name": "milestone",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by milestone slug",
              "type": "string",
              "nullable": true
            },
            "description": "Filter by milestone slug"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IssueSchema"
                  },
                  "title": "Response Listissues"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/entities/issues/{issue_id}": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "Get issue details",
        "operationId": "getIssue",
        "parameters": [
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
