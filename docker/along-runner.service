[Unit]
Description=Along VPS Runner Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=along
Group=along
WorkingDirectory=/workspace
EnvironmentFile=-/etc/along/runner.env
ExecStart=/usr/local/bin/along daemon start --foreground
Restart=always
RestartSec=10
# Exit 78 (EX_CONFIG) means the bot token was rejected; restarting cannot fix it.
RestartPreventExitStatus=78
KillSignal=SIGTERM
# The daemon waits up to 20 s for a running task after SIGTERM.
TimeoutStopSec=30
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
