#!/usr/bin/env bash
# docker/git-credential-along - Ephemeral Git credential helper for GitHub
set -euo pipefail

ACTION="${1:-}"
if [ "$ACTION" != "get" ]; then
    exit 0
fi

HOST=""
while IFS='=' read -r key value || [ -n "$key" ]; do
    key="$(echo "${key:-}" | tr -d '\r' | xargs)"
    value="$(echo "${value:-}" | tr -d '\r' | xargs)"
    [ -z "$key" ] && break
    if [ "$key" = "host" ]; then
        HOST="$value"
    fi
done

if [ "$HOST" = "github.com" ] && [ -n "${GITHUB_TOKEN:-}" ]; then
    printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN"
fi
