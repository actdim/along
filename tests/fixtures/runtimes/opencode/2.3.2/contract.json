{
  "runtime": "opencode",
  "version": "2.3.2",
  "min_supported_version": "2.3.2",
  "run_flags": [
    "--continue", "-c",
    "--session", "-s",
    "--fork",
    "--worktree", "-w",
    "--model", "-m",
    "--agent",
    "--format",
    "--file", "-f",
    "--title",
    "--archived",
    "--thinking",
    "--auto",
    "--help", "-h",
    "--version", "-v",
    "--wizard",
    "--completions",
    "--log-level",
    "--print-logs",
    "--standalone",
    "--server"
  ],
  "tool_hooks": [
    "execute.before",
    "execute.after"
  ],
  "session_hooks": [
    "experimental.idle",
    "experimental.model.resolve",
    "experimental.ws.handshake",
    "experimental.ws.receive",
    "experimental.ws.send",
    "fork",
    "http.request",
    "http.response",
    "model.request",
    "prompt",
    "retry",
    "title"
  ],
  "shell_hooks": [
    "create.before"
  ],
  "required_plugin_hooks": {
    "tool": ["execute.before", "execute.after"],
    "session": ["experimental.idle", "prompt"],
    "shell": ["create.before"]
  }
}
