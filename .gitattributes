# Git configuration for Along Protocol repositories
# Ensure clean LF line endings for Markdown and text files
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Append-only Along protocol files: automatic union merge driver to prevent merge conflicts
.along/HISTORY.md merge=union
.along/DECISIONS.md merge=union
