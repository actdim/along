# Git configuration for Along Protocol repositories
# Ensure clean LF line endings for text files
* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Append-only Along protocol files: automatic union merge driver to prevent merge conflicts
.along/HISTORY.md merge=union
.along/DECISIONS.md merge=union

# >>> along git setup (managed merge drivers) >>>
**/.along/**/*.md -merge
**/docs/**/*.md -merge
AGENTS.md -merge
CLAUDE.md -merge
**/.along/HISTORY.md merge=union
# <<< along git setup <<<
